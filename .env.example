# Flipbook Dynamite — environment variables
# Copy to `.env.local` for local dev. In production set these in Vercel.
# With NONE of these set, the app runs in "open mode" + filesystem storage
# (zero-config local dev): no sign-in, PDFs stored under ./data.

# ── Sign a stable secret for access tokens (REQUIRED in production) ──────────
# Used to sign password-unlock cookies and derive anonymous visitor ids.
# Without it, unlock sessions and unique-visitor counts reset on every restart.
# Generate one: `openssl rand -hex 32`
FLIPBOOK_SECRET=

# ── Supabase (cloud storage + database) ─────────────────────────────────────
# Set all three to run against Supabase instead of the local filesystem.
NEXT_PUBLIC_SUPABASE_URL=https://tujhvzaxwjgzupqzmakx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED for Supabase mode. Held ONLY on the server — never exposed to the
# browser. The app uses it to issue one-time signed upload URLs and short-lived
# signed download URLs against the PRIVATE `flipbook-pdfs` bucket, and to
# read/write the `flipbook_books` / `flipbook_events` tables. The anon key can
# no longer touch storage or the tables directly (RLS locks it out), so without
# this key Supabase mode will not work.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (accounts / per-user libraries) ───────────────────────────────────
# Set both to turn on sign-in and per-user ownership.
#
# ⚠️  WITHOUT Clerk keys the app runs in OPEN MODE: there are no accounts, so
#     there is NO management authorization — ANY visitor can edit, delete,
#     re-brand, set passwords/visibility, add overlays, and view insights for
#     ANY book. Password/private books still gate VIEWING, but not management.
#     Open mode is only for local dev or a trusted single-user/self-host box.
#     For any real/multi-tenant deployment, set these two keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Point Clerk at the app's own login/signup pages and land users in /app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ── Stripe (paid plans) — optional ──────────────────────────────────────────
# When set, the pricing page's "Choose <plan>" buttons open a real Stripe
# Checkout. Without these, they fall back to sign-up so the site still works.
# Create recurring Prices in Stripe and paste their price_… ids here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=

# ── App URL (used for absolute share/embed links) ───────────────────────────
NEXT_PUBLIC_APP_URL=https://www.flipbookdynamite.com

# ── Optional: override the local filesystem data directory (open mode) ───────
# FLIPBOOK_DATA_DIR=./data
